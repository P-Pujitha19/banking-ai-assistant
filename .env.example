# ---------- Copy to .env and edit. NEVER commit .env ----------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.log
LOG_JSON=true
DEMO_MODE=true

# ---------- LLM (optional) ----------
# mock   = deterministic demo mode, no API key needed (intent model, tools, RAG, memory all still work)
# openai = OpenAI (or any OpenAI-compatible endpoint via LLM_BASE_URL)
# gemini = Google Gemini
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_STEPS=4
USE_LLM_ENTITY_EXTRACTION=false

# ---------- Mock banking API ----------
# http      = assistant calls the FastAPI mock bank (start it on port 8001)
# inprocess = assistant calls the same logic directly (no second server)
BANK_API_MODE=http
BANK_API_URL=http://127.0.0.1:8001
BANK_API_KEY=dev-only-change-me
BANK_API_TIMEOUT_SECONDS=5
BANK_DATA_DIR=data/bank
# Empty = the bank's "today" is the latest transaction date in the synthetic data
BANK_AS_OF_DATE=

# ---------- Assistant API / UI ----------
ASSISTANT_API_URL=http://127.0.0.1:8000

# ---------- ML ----------
# auto = TensorFlow model if trained, else scikit-learn baseline (with a logged warning)
INTENT_BACKEND=auto
INTENT_MODEL_DIR=models/intent
INTENT_CONFIDENCE_THRESHOLD=0.60

# ---------- RAG ----------
# EMBEDDING_PROVIDER: tfidf (offline default) | huggingface (recommended, semantic) | openai
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_BACKEND=auto
VECTOR_STORE_DIR=models/vector_store
RAG_TOP_K=4
RAG_MIN_SCORE=0.12

# ---------- Safety / sessions ----------
MAX_MESSAGE_CHARS=500
SESSION_TTL_MINUTES=30
MAX_HISTORY_TURNS=10
